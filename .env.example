# --- runtime ---
ENV=development                      # development | test | production
LOG_LEVEL=INFO
SECRET_KEY=dev-secret-change-me-before-production   # generate a random 16+ char value for anything public; production refuses this default and the public overlay refuses to start without one

# --- storage ---
DATABASE_URL=sqlite:///./trainer.db  # compose overrides with postgresql+psycopg://...
RUN_MIGRATIONS=true
POSTGRES_PASSWORD=trainer-dev-password   # used by compose for the bundled Postgres only

# --- identity ---
AUTH_BACKEND=dev                     # dev | invite | oidc | ldap | proxy (oidc, ldap, proxy arrive in M6). invite requires LITELLM_ADMIN_KEY. The public overlay forces invite
ADMIN_GROUPS=compliance              # comma separated identity-provider groups that get the admin role
# required when AUTH_BACKEND=proxy
PROXY_TRUSTED_ADDRESSES=
SESSION_MAX_AGE_SECONDS=43200
GUEST_ACCESS=false                   # true opens POST /api/auth/guest, with any backend
GUEST_SEATS=10                       # guests with a turn in the last ten minutes; the next one waits
GUEST_RETENTION_HOURS=6              # a guest idle this long loses every row, checked hourly
PUBLIC_URL=http://localhost:8000     # the base of invite links

# --- models through LiteLLM ---
# inside compose. From the host use http://localhost:4000/v1
LLM_BASE_URL=http://litellm:4000/v1
LLM_API_KEY=sk-dev-master
# a proxy key that may create keys and read spend. Empty turns budgets off: everyone
# calls with LLM_API_KEY. The public overlay falls back to LITELLM_MASTER_KEY
LITELLM_ADMIN_KEY=
LLM_MODEL_STRONG=strong
LLM_MODEL_FAST=fast
LLM_MODEL_EMBED=
LLM_TIMEOUT_SECONDS=60
EXCERPT_BUDGET_CHARS=1200             # characters of cited law text a prompt carries per citation
SEARCH_TOP_K=5                        # hits the BM25 index returns for one query. Unused so far
TURN_BUDGET_SECONDS=20                # critic retries stop after this; the best draft ships
# dev profile only: the bundled LiteLLM reads these
LITELLM_MASTER_KEY=sk-dev-master
GROQ_API_KEY=

# --- data and compliance (D7, D15) ---
DATA_LEVEL=0                         # 0 pass only | 1 attempts and scores | 2 transcripts
RETENTION_DAYS=30                    # named users idle this long lose their threads and turns, checked hourly; pass records stay
RETRAIN_ON_MAJOR_VERSION=true
PASS_THRESHOLD=8
TRAINING_INTERVAL_DAYS=365
TURN_LIMIT_USER_DAY=300              # spend guard: streamed turns per student per rolling day
TURN_LIMIT_GUEST_DAY=150             # spend guard: streamed turns per guest per rolling day
TURN_LIMIT_GLOBAL_DAY=2000           # spend guard: streamed turns across all students per rolling day
FEATURE_ADMIN_VIEW=false
FEATURE_CERTIFICATE=false
FEATURE_REMINDERS=false              # requires SMTP_HOST
FEATURE_DEPARTMENT_STATS=false
FEATURE_AUDIT_LOG=false              # requires DATA_LEVEL=2
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- theme (D11) ---
THEME_PRIMARY=#38bdf8
THEME_SECONDARY=#16233a
THEME_ACCENT=#fbbf24
THEME_BACKGROUND=#f8fafc
THEME_LOOK=pixel                     # pixel | clean

# --- paths ---
# Each of these is set by the image. Override one for a local run.
# CONTENT_DIR=/app/content
# CONTENT_OVERLAY_DIR=/app/overlay     # unset by default, so no overlay. Set it to layer local content on top.
# PERSONAS_DIR=/app/personas
# CORPUS_DIR=/app/corpus
# FRONTEND_DIST=/app/frontend
# FONTS_DIR=/app/fonts

# --- frontend build (optional) ---
# Leave VITE_TOLGEE_* unset for public builds: the API key would ship in the JS bundle.
# VITE_TOLGEE_API_URL=
# VITE_TOLGEE_API_KEY=

# --- content tooling ---
# Only tools/generate_avatars.py reads this. The app never does, and a deployment
# does not need it: persona portraits are generated once and committed.
REPLICATE_API_TOKEN=
